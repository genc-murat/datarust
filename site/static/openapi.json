{
  "openapi": "3.1.0",
  "info": {
    "title": "datarust API",
    "version": "1.0.0",
    "description": "Classical machine learning, feature preprocessing pipelines, and automated dataset profiling in Rust with bit-exact scikit-learn parity.\n\n### Versioning & Deprecation Policy\nThis API uses URI path versioning (`/v1/`). All minor and backward-compatible changes are published within the current major version. Breaking changes will increment the major version path (`/v2/`). Deprecated endpoints remain supported for a minimum of 6 months following formal notice via `Deprecation` and `Sunset` HTTP response headers.\n\n### Free Tier & Sandbox Access\n100% Free and open-source under the MIT license. No API keys or credit cards required. Instant sandbox access is available for developers and autonomous AI agents.",
    "contact": {
      "name": "datarust maintainers",
      "url": "https://datarust.dev",
      "email": "murat@datarust.dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://datarust.dev/v1",
      "description": "Production v1 Endpoint"
    },
    {
      "url": "https://datarust.dev",
      "description": "Root Server"
    }
  ],
  "paths": {
    "/profile": {
      "post": {
        "operationId": "profileDataset",
        "summary": "Profile tabular dataset",
        "description": "Calculates descriptive statistics, distribution shapes, quality warnings, and pairwise relationships.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful dataset profile generation",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" }
        }
      }
    },
    "/train": {
      "post": {
        "operationId": "trainModel",
        "summary": "Train machine learning estimator",
        "description": "Fits linear models, decision trees, or random forests with scikit-learn parity.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trained estimator weights and score",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" }
        }
      }
    },
    "/scale": {
      "post": {
        "operationId": "scaleFeatures",
        "summary": "Scale feature matrix",
        "description": "Transforms numerical features using standard, minmax, or robust scaling.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScaleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scaled feature matrix",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScaleResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List asynchronous jobs with pagination",
        "description": "Retrieves a paginated collection of asynchronous training and profiling jobs.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number to retrieve (1-based)",
            "required": false,
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page",
            "required": false,
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor for the next page",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of jobs",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedJobsResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" }
        }
      },
      "post": {
        "operationId": "submitAsyncJob",
        "summary": "Submit long-running asynchronous ML or profiling job",
        "description": "Enqueues an asynchronous workload and returns a 202 Accepted status with a polling URL.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted and queued for execution",
            "headers": {
              "Location": {
                "description": "URL to poll for job status",
                "schema": { "type": "string", "example": "/v1/jobs/job_12345" }
              },
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAcceptedResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "getJobStatus",
        "summary": "Get asynchronous job status and result",
        "description": "Polls the execution status and output metrics of a previously submitted asynchronous job.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the job",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current status or completed results of the asynchronous job",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Unique client-generated idempotency key preventing duplicate execution of mutate operations.",
        "schema": {
          "type": "string",
          "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
        }
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Maximum number of requests permitted in the current time window.",
        "schema": { "type": "integer", "example": 1000 }
      },
      "RateLimitRemaining": {
        "description": "Remaining request quota in the current window.",
        "schema": { "type": "integer", "example": 999 }
      },
      "RateLimitReset": {
        "description": "Time in seconds until the current rate-limit window resets.",
        "schema": { "type": "integer", "example": 60 }
      },
      "IdempotencyKeyHeader": {
        "description": "Echoes the idempotency key associated with this request.",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "400BadRequest": {
        "description": "Bad Request - malformed payload or parameters",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "404NotFound": {
        "description": "Resource or endpoint not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "422Unprocessable": {
        "description": "Validation error on input data",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "429TooManyRequests": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "500InternalError": {
        "description": "Internal server execution error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message", "status"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error classification",
            "example": "invalid_payload"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of the error",
            "example": "Invalid JSON payload structure"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 400
          },
          "details": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Detailed validation or execution error items"
          }
        }
      },
      "PaginatedJobsResponse": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JobSummary" }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": ["page", "limit", "total", "has_more"],
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 20 },
          "total": { "type": "integer", "example": 100 },
          "has_more": { "type": "boolean", "example": false },
          "next_cursor": { "type": "string", "nullable": true, "example": null }
        }
      },
      "JobSummary": {
        "type": "object",
        "required": ["job_id", "status", "created_at"],
        "properties": {
          "job_id": { "type": "string", "example": "job_123456" },
          "task": { "type": "string", "example": "dataset_profiling" },
          "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"], "example": "completed" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "JobSubmitRequest": {
        "type": "object",
        "required": ["task", "parameters"],
        "properties": {
          "task": { "type": "string", "enum": ["train", "profile", "scale"] },
          "parameters": { "type": "object" }
        }
      },
      "JobAcceptedResponse": {
        "type": "object",
        "required": ["job_id", "status", "poll_url"],
        "properties": {
          "job_id": { "type": "string", "example": "job_123456" },
          "status": { "type": "string", "example": "queued" },
          "progress": { "type": "integer", "example": 0 },
          "poll_url": { "type": "string", "example": "https://datarust.dev/v1/jobs/job_123456" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "JobStatusResponse": {
        "type": "object",
        "required": ["job_id", "status", "progress"],
        "properties": {
          "job_id": { "type": "string", "example": "job_123456" },
          "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"], "example": "completed" },
          "progress": { "type": "integer", "example": 100 },
          "result": { "type": "object" },
          "created_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ProfileRequest": {
        "type": "object",
        "required": ["csv_data"],
        "properties": {
          "csv_data": { "type": "string", "description": "CSV dataset content" },
          "target_column": { "type": "string", "description": "Target column for association detection" }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "required": ["row_count", "column_count", "columns"],
        "properties": {
          "row_count": { "type": "integer" },
          "column_count": { "type": "integer" },
          "columns": { "type": "array", "items": { "type": "object" } },
          "quality_warnings": { "type": "array", "items": { "type": "string" } },
          "correlations": { "type": "object" }
        }
      },
      "TrainRequest": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "model": { "type": "string", "default": "linear_regression" },
          "x": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
          "y": { "type": "array", "items": { "type": "number" } }
        }
      },
      "TrainResponse": {
        "type": "object",
        "required": ["coefficients", "r2_score"],
        "properties": {
          "model": { "type": "string" },
          "coefficients": { "type": "array", "items": { "type": "number" } },
          "intercept": { "type": "number" },
          "r2_score": { "type": "number" },
          "status": { "type": "string" }
        }
      },
      "ScaleRequest": {
        "type": "object",
        "required": ["x"],
        "properties": {
          "method": { "type": "string", "enum": ["standard", "minmax", "robust"], "default": "standard" },
          "x": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
        }
      },
      "ScaleResponse": {
        "type": "object",
        "required": ["scaled_x"],
        "properties": {
          "method": { "type": "string" },
          "scaled_x": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
          "status": { "type": "string" }
        }
      }
    }
  }
}
