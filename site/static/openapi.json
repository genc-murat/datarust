{
  "openapi": "3.1.0",
  "info": {
    "title": "datarust API",
    "version": "1.0.0",
    "description": "Classical machine learning, feature preprocessing pipelines, and automated dataset profiling in Rust with bit-exact scikit-learn parity.\n\n### Versioning & Deprecation Policy\nThis API uses URI path versioning (`/v1/`). All minor and backward-compatible changes are published within the current major version. Breaking changes will increment the major version path (`/v2/`). Deprecated endpoints remain supported for a minimum of 6 months following formal notice via `Deprecation` and `Sunset` HTTP response headers.\n\n### Free Tier & Sandbox Access\n100% Free and open-source under the MIT license. No API keys or credit cards required. Instant sandbox access is available for developers and autonomous AI agents.",
    "contact": {
      "name": "datarust maintainers",
      "url": "https://datarust.dev",
      "email": "murat@datarust.dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://datarust.dev/v1",
      "description": "Production v1 Endpoint"
    }
  ],
  "paths": {
    "/profile": {
      "post": {
        "operationId": "profileDataset",
        "summary": "Profile tabular dataset",
        "description": "Calculates descriptive statistics, distribution shapes, quality warnings, and pairwise relationships.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful dataset profile generation",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotent-Replayed": { "$ref": "#/components/headers/IdempotentReplayed" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "409": { "$ref": "#/components/responses/409IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/413RequestTooLarge" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    },
    "/train": {
      "post": {
        "operationId": "trainModel",
        "summary": "Train machine learning estimator",
        "description": "Fits a Rust regression estimator and returns its in-sample score and sample predictions.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trained estimator weights and score",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotent-Replayed": { "$ref": "#/components/headers/IdempotentReplayed" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "409": { "$ref": "#/components/responses/409IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/413RequestTooLarge" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    },
    "/scale": {
      "post": {
        "operationId": "scaleFeatures",
        "summary": "Scale feature matrix",
        "description": "Transforms numerical features using standard, minmax, or robust scaling.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScaleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scaled feature matrix",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotent-Replayed": { "$ref": "#/components/headers/IdempotentReplayed" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScaleResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "409": { "$ref": "#/components/responses/409IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/413RequestTooLarge" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    },
    "/evaluate": {
      "post": {
        "operationId": "evaluateMetrics",
        "summary": "Compute regression or classification metrics",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["y_true", "y_pred"],
                "properties": {
                  "task": { "type": "string", "enum": ["regression", "classification"], "default": "regression" },
                  "y_true": { "type": "array", "items": { "type": "number" } },
                  "y_pred": { "type": "array", "items": { "type": "number" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Computed metrics for the selected task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["task"],
                  "properties": {
                    "task": { "type": "string" },
                    "r2": { "type": ["number", "null"], "description": "Null for a single observation." },
                    "mse": { "type": "number" },
                    "rmse": { "type": "number" },
                    "mae": { "type": "number" },
                    "accuracy": { "type": "number" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "409": { "$ref": "#/components/responses/409IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/413RequestTooLarge" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "security": [{ "JobToken": [] }],
        "summary": "List asynchronous jobs with pagination",
        "description": "Lists retained jobs in this token’s collection. Send either page or cursor. Jobs and results expire 30 minutes after submission.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number to retrieve (1-based)",
            "required": false,
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page",
            "required": false,
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor for the next page",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of jobs",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedJobsResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "401": { "$ref": "#/components/responses/401JobTokenRequired" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      },
      "post": {
        "operationId": "submitAsyncJob",
        "security": [{}, { "JobToken": [] }],
        "summary": "Submit long-running asynchronous ML or profiling job",
        "description": "Enqueues an asynchronous workload and returns 202 with a polling URL and an X-Job-Token. Supply a previous token to add work to its collection.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted and queued for execution",
            "headers": {
              "X-Job-Token": {
                "description": "Private token for polling, listing, and submitting jobs to this collection.",
                "schema": { "type": "string", "minLength": 43, "maxLength": 43 }
              },
              "Location": {
                "description": "URL to poll for job status",
                "schema": { "type": "string", "example": "/v1/jobs/job_12345" }
              },
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "Idempotent-Replayed": { "$ref": "#/components/headers/IdempotentReplayed" },
              "Idempotency-Key": { "$ref": "#/components/headers/IdempotencyKeyHeader" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAcceptedResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "409": { "$ref": "#/components/responses/409IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/413RequestTooLarge" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "getJobStatus",
        "security": [{ "JobToken": [] }],
        "summary": "Get asynchronous job status and result",
        "description": "Returns execution status and the operation result for a job in this token’s collection.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the job",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current status or completed results of the asynchronous job",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400BadRequest" },
          "401": { "$ref": "#/components/responses/401JobTokenRequired" },
          "404": { "$ref": "#/components/responses/404NotFound" },
          "422": { "$ref": "#/components/responses/422Unprocessable" },
          "429": { "$ref": "#/components/responses/429TooManyRequests" },
          "500": { "$ref": "#/components/responses/500InternalError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JobToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Job-Token",
        "description": "Anonymous private job collection token returned on submission. Use a previous token when submitting related jobs."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "A unique, unpredictable client-generated key. Identical requests replay for 30 minutes. Reusing a key with different input on the same operation returns 409.",
        "schema": {
          "type": "string",
          "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
        }
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Maximum number of requests permitted in the current time window.",
        "schema": { "type": "integer", "example": 1000 }
      },
      "RateLimitRemaining": {
        "description": "Remaining request quota in the current window.",
        "schema": { "type": "integer", "example": 999 }
      },
      "RateLimitReset": {
        "description": "Time in seconds until the current rate-limit window resets.",
        "schema": { "type": "integer", "example": 60 }
      },
      "IdempotentReplayed": {
        "description": "Whether the response was replayed from the retained request.",
        "schema": { "type": "string", "enum": ["true", "false"] }
      },
      "IdempotencyKeyHeader": {
        "description": "Echoes the idempotency key associated with this request.",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "401JobTokenRequired": {
        "description": "Job collection token is required.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "400BadRequest": {
        "description": "Bad Request - malformed payload or parameters",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "404NotFound": {
        "description": "Resource or endpoint not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "409IdempotencyConflict": {
        "description": "Idempotency key was previously used with different input.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "413RequestTooLarge": {
        "description": "The request body exceeds 256 KiB.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "422Unprocessable": {
        "description": "Validation error on input data",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "429TooManyRequests": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "500InternalError": {
        "description": "Internal server execution error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "DefaultError": {
        "description": "Unexpected standard error response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message", "status"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error classification",
            "example": "invalid_payload"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of the error",
            "example": "Invalid JSON payload structure"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 400
          },
          "details": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Detailed validation or execution error items"
          }
        }
      },
      "PaginatedJobsResponse": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JobSummary" }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": ["page", "limit", "total", "has_more"],
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 20 },
          "total": { "type": "integer", "example": 100 },
          "has_more": { "type": "boolean", "example": false },
          "next_cursor": { "type": ["string", "null"], "example": null }
        }
      },
      "JobSummary": {
        "type": "object",
        "required": ["job_id", "status", "created_at"],
        "properties": {
          "job_id": { "type": "string", "example": "job_123456" },
          "task": { "type": "string", "example": "profile" },
          "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"], "example": "completed" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "JobSubmitRequest": {
        "type": "object",
        "required": ["task", "parameters"],
        "properties": {
          "task": { "type": "string", "enum": ["train", "profile", "scale", "evaluate"] },
          "parameters": { "type": "object" }
        }
      },
      "JobAcceptedResponse": {
        "type": "object",
        "required": ["job_id", "status", "poll_url"],
        "properties": {
          "job_id": { "type": "string", "example": "job_123456" },
          "status": { "type": "string", "example": "queued" },
          "progress": { "type": "integer", "example": 0 },
          "poll_url": { "type": "string", "example": "https://datarust.dev/v1/jobs/job_123456" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "JobStatusResponse": {
        "type": "object",
        "required": ["job_id", "status", "progress"],
        "properties": {
          "job_id": { "type": "string", "example": "job_123456" },
          "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"], "example": "completed" },
          "progress": { "type": "integer", "example": 100 },
          "result": { "type": "object" },
          "created_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" },
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        }
      },
      "ProfileRequest": {
        "type": "object",
        "required": ["csv_data"],
        "properties": {
          "csv_data": { "type": "string", "description": "CSV dataset content" },
          "target_column": { "type": "string", "description": "Target column for association detection" }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "required": ["row_count", "column_count", "columns"],
        "properties": {
          "row_count": { "type": "integer" },
          "column_count": { "type": "integer" },
          "target_column": { "type": ["string", "null"] },
          "relationships": { "type": ["object", "null"] },
          "columns": { "type": "array", "items": { "type": "object" } },
          "quality_warnings": { "type": "array", "items": { "type": "string" } },
          "correlations": { "type": "object" }
        }
      },
      "TrainRequest": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "model": { "type": "string", "enum": ["linear_regression", "decision_tree", "random_forest"], "default": "linear_regression" },
          "x": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
          "y": { "type": "array", "items": { "type": "number" } }
        }
      },
      "TrainResponse": {
        "type": "object",
        "required": ["model", "r2_score", "predictions_sample", "status"],
        "properties": {
          "model": { "type": "string" },
          "coefficients": { "type": "array", "items": { "type": "number" }, "description": "Returned for linear regression" },
          "predictions_sample": { "type": "array", "items": { "type": "number" }, "maxItems": 10 },
          "mean_squared_error": { "type": "number" },
          "intercept": { "type": "number" },
          "r2_score": { "type": ["number", "null"], "description": "Null for a single observation." },
          "status": { "type": "string" }
        }
      },
      "ScaleRequest": {
        "type": "object",
        "required": ["x"],
        "properties": {
          "method": { "type": "string", "enum": ["standard", "minmax", "robust"], "default": "standard" },
          "x": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
        }
      },
      "ScaleResponse": {
        "type": "object",
        "required": ["scaled_x"],
        "properties": {
          "method": { "type": "string" },
          "scaled_x": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
          "status": { "type": "string" }
        }
      }
    }
  }
}
