{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datarust",
  "account_id": "a9586af5ab9d93b50bc28a551cd348fb",
  "compatibility_date": "2026-07-26",
  "routes": [
    {
      "pattern": "datarust.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "API_STATE", "class_name": "ApiState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ApiState"] }
  ],
  "main": "./src/worker.js"
}
