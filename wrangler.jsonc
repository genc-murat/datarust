{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datarust",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-26",
  "routes": [
    {
      "pattern": "datarust.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
